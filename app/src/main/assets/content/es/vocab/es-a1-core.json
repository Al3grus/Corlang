    },
    {
     "id": "eso",
     "hr": "eso",
     "en": "that (neuter)",
     "pos": "pron.",
     "example": {
      "target": "Eso no es verdad.",
      "gloss": "That's not true."
     }
    },
    {
     "id": "mi",
     "hr": "mi",
     "en": "my",
     "pos": "pron.",
     "note": "invariable for gender, plural mis; not to be confused with mí, used after a preposition",
     "example": {
      "target": "Mi trabajo está en el centro.",
      "gloss": "My job is downtown."
     }
    },
    {
     "id": "tu",
     "hr": "tu",
     "en": "your (informal)",
     "pos": "pron.",
     "note": "invariable for gender, plural tus; not to be confused with tú, the pronoun",
