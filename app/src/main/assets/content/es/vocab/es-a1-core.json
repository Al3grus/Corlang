    },
    {
     "id": "su",
     "hr": "su",
     "en": "his, her, your (formal), their",
     "pos": "pron.",
     "note": "invariable for gender, agrees only in number: sus",
     "example": {
      "target": "Su idea es buena.",
      "gloss": "His (her) idea is good."
     }
    },
    {
     "id": "nuestro",
     "hr": "nuestro",
     "en": "our",
     "pos": "pron.",
     "note": "agrees in gender and number: nuestra, nuestros, nuestras; the vosotros-equivalent is vuestro",
     "example": {
      "target": "Nuestro plan es simple.",
      "gloss": "Our plan is simple."
