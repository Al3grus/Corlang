{
 "packs": [
  {
   "id": "es-a1-core",
   "title": "Core words and first contact",
   "level": "A1",
   "sources": [
    "freq-es"
   ],
   "words": [
    {
     "id": "hola",
     "hr": "hola",
     "en": "hello",
     "pos": "expr.",
     "example": {
      "target": "Hola, ¿cómo estás?",
      "gloss": "Hello, how are you?"
     }
    },
    {
     "id": "adiós",
     "hr": "adiós",
     "en": "goodbye",
     "pos": "expr.",
     "example": {
      "target": "Adiós, hasta mañana.",
      "gloss": "Goodbye, see you tomorrow."
     }
    },
    {
     "id": "buenos días",
     "hr": "buenos días",
     "en": "good morning",
     "pos": "expr.",
     "note": "used until roughly midday",
     "example": {
      "target": "Buenos días, ¿cómo está usted?",
      "gloss": "Good morning, how are you (formal)?"
     }
    },
    {
     "id": "buenas tardes",
     "hr": "buenas tardes",
     "en": "good afternoon",
     "pos": "expr.",
     "note": "used from midday until nightfall",
     "example": {
      "target": "Buenas tardes, ¿qué tal?",
      "gloss": "Good afternoon, how's it going?"
     }
    },
    {
     "id": "buenas noches",
     "hr": "buenas noches",
     "en": "good night, good evening",
     "pos": "expr.",
     "note": "used both as a nighttime greeting and as a farewell",
     "example": {
      "target": "Buenas noches, hasta mañana.",
      "gloss": "Good night, see you tomorrow."
     }
    },
    {
     "id": "por favor",
     "hr": "por favor",
     "en": "please",
     "pos": "expr.",
     "example": {
      "target": "Un café, por favor.",
      "gloss": "A coffee, please."
     }
    },
    {
     "id": "gracias",
     "hr": "gracias",
     "en": "thank you",
     "pos": "expr.",
     "note": "the standard reply is de nada, you're welcome",
     "example": {
      "target": "Muchas gracias por tu ayuda.",
      "gloss": "Thank you very much for your help."
     }
    },
    {
     "id": "perdón",
     "hr": "perdón",
     "en": "sorry, excuse me",
     "pos": "expr.",
     "note": "used both to apologise and to get someone's attention politely",
     "example": {
      "target": "Perdón, ¿dónde está la estación?",
      "gloss": "Excuse me, where is the station?"
     }
    },
    {
     "id": "qué",
     "hr": "qué",
     "en": "what",
     "pos": "pron.",
     "note": "combines with por to ask why: ¿por qué?",
     "example": {
      "target": "¿Qué haces ahora?",
      "gloss": "What are you doing now?"
     }
    },
    {
     "id": "quién",
     "hr": "quién",
     "en": "who",
     "pos": "pron.",
     "note": "plural quiénes, for asking about more than one person",
     "example": {
      "target": "¿Quién habla español aquí?",
      "gloss": "Who speaks Spanish here?"
     }
    },
    {
     "id": "cómo",
     "hr": "cómo",
     "en": "how",
     "pos": "adv.",
     "example": {
      "target": "¿Cómo estás hoy?",
      "gloss": "How are you today?"
     }
    },
    {
     "id": "dónde",
     "hr": "dónde",
     "en": "where",
     "pos": "adv.",
     "example": {
      "target": "¿Dónde vives?",
      "gloss": "Where do you live?"
     }
    },
    {
     "id": "cuándo",
     "hr": "cuándo",
     "en": "when",
     "pos": "adv.",
     "example": {
      "target": "¿Cuándo trabajas?",
      "gloss": "When do you work?"
     }
    },
    {
     "id": "cuánto",
     "hr": "cuánto",
     "en": "how much, how many",
     "pos": "pron.",
     "note": "agrees in gender and number when it modifies a noun: cuánta, cuántos, cuántas",
     "example": {
      "target": "¿Cuánto cuesta el billete?",
      "gloss": "How much does the ticket cost?"
     }
    },
    {
     "id": "cuál",
     "hr": "cuál",
     "en": "which one",
     "pos": "pron.",
     "note": "plural cuáles",
     "example": {
      "target": "¿Cuál prefieres, el té o el café?",
      "gloss": "Which do you prefer, tea or coffee?"
     }
    },
    {
     "id": "yo",
     "hr": "yo",
     "en": "I",
     "pos": "pron.",
     "example": {
      "target": "Yo hablo español y un poco de inglés.",
      "gloss": "I speak Spanish and a little English."
     }
    },
    {
     "id": "tú",
     "hr": "tú",
     "en": "you (informal singular)",
     "pos": "pron.",
     "note": "not to be confused with tu, the possessive, which has no accent",
     "example": {
      "target": "Tú vives en Madrid, ¿verdad?",
      "gloss": "You live in Madrid, right?"
     }
    },
    {
     "id": "él",
     "hr": "él",
     "en": "he",
     "pos": "pron.",
     "example": {
      "target": "Él trabaja en una oficina.",
      "gloss": "He works in an office."
     }
    },
    {
     "id": "ella",
     "hr": "ella",
     "en": "she",
     "pos": "pron.",
     "example": {
      "target": "Ella estudia en la universidad.",
      "gloss": "She studies at university."
     }
    },
    {
     "id": "usted",
     "hr": "usted",
     "en": "you (formal singular)",
     "pos": "pron.",
     "note": "takes third-person verb forms even though it means you; the plural formal is ustedes",
     "example": {
      "target": "¿Usted habla inglés?",
      "gloss": "Do you speak English?"
     }
    },
    {
     "id": "nosotros",
     "hr": "nosotros",
     "en": "we (masculine or mixed)",
     "pos": "pron.",
     "note": "feminine form nosotras, for an all-female group",
     "example": {
      "target": "Nosotros vamos a la playa.",
      "gloss": "We are going to the beach."
     }
    },
    {
     "id": "vosotros",
     "hr": "vosotros",
     "en": "you all (informal plural, Spain)",
     "pos": "pron.",
     "note": "feminine form vosotras; used in Spain, replaced by ustedes in Latin America",
     "example": {
      "target": "Vosotros habláis muy rápido.",
      "gloss": "You all speak very fast."
     }
    },
    {
     "id": "ellos",
     "hr": "ellos",
     "en": "they (masculine or mixed)",
     "pos": "pron.",
     "note": "feminine form ellas, for an all-female group",
     "example": {
      "target": "Ellos viven cerca del río.",
      "gloss": "They live near the river."
     }
    },
    {
     "id": "ellas",
     "hr": "ellas",
     "en": "they (feminine)",
     "pos": "pron.",
     "example": {
      "target": "Ellas trabajan en el centro.",
      "gloss": "They work downtown."
     }
    },
    {
     "id": "el",
     "hr": "el",
     "en": "the (masculine singular)",
     "pos": "art.",
     "note": "used directly before a masculine singular noun: el coche",
     "example": {
      "target": "El coche es nuevo.",
      "gloss": "The car is new."
     }
    },
    {
     "id": "la",
     "hr": "la",
     "en": "the (feminine singular); her, it (feminine, direct object)",
     "pos": "pron.",
     "note": "as an article, la casa; as a pronoun, it replaces a feminine noun already mentioned: la veo",
     "example": {
      "target": "La veo todos los días.",
      "gloss": "I see her (it) every day."
     }
    },
    {
     "id": "los",
     "hr": "los",
     "en": "the (masculine plural); them (masculine, direct object)",
     "pos": "pron.",
     "note": "as an article, los libros; as a pronoun, los veo means I see them",
     "example": {
      "target": "Los necesito para el trabajo.",
      "gloss": "I need them for work."
     }
    },
    {
     "id": "las",
     "hr": "las",
     "en": "the (feminine plural); them (feminine, direct object)",
     "pos": "pron.",
     "note": "as an article, las gafas; as a pronoun, las veo means I see them",
     "example": {
      "target": "Las necesito hoy.",
      "gloss": "I need them today."
     }
    },
    {
     "id": "un",
     "hr": "un",
     "en": "a, an (masculine)",
     "pos": "art.",
     "note": "apocopated form of uno, used before a masculine noun",
     "example": {
      "target": "Quiero un café, por favor.",
      "gloss": "I want a coffee, please."
     }
    },
    {
     "id": "una",
     "hr": "una",
     "en": "a, an (feminine)",
     "pos": "art.",
     "example": {
      "target": "Tengo una pregunta.",
      "gloss": "I have a question."
     }
    },
    {
     "id": "lo",
     "hr": "lo",
     "en": "him, it (masculine or neuter, direct object)",
     "pos": "pron.",
     "note": "also combines with an adjective to form an abstract noun: lo bueno, the good thing",
     "example": {
      "target": "No lo sé.",
      "gloss": "I don't know it."
     }
    },
    {
     "id": "me",
     "hr": "me",
     "en": "me (object pronoun)",
     "pos": "pron.",
     "note": "used for direct object, indirect object, and reflexively with verbs like llamarse",
     "example": {
      "target": "Me llamo Ana.",
      "gloss": "My name is Ana."
     }
    },
    {
     "id": "te",
     "hr": "te",
     "en": "you (object pronoun, informal)",
     "pos": "pron.",
     "example": {
      "target": "¿Cómo te llamas?",
      "gloss": "What is your name?"
     }
    },
    {
     "id": "le",
     "hr": "le",
     "en": "him, her, you (indirect object pronoun)",
     "pos": "pron.",
     "note": "the usual choice with gustar-type verbs: le gusta el café",
     "example": {
      "target": "A ella le gusta el café.",
      "gloss": "She likes coffee."
     }
    },
    {
     "id": "este",
     "hr": "este",
     "en": "this (masculine)",
     "pos": "pron.",
     "note": "feminine esta; the farther-away equivalents ese and esa follow the same pattern",
     "example": {
      "target": "Este libro es interesante.",
      "gloss": "This book is interesting."
     }
    },
    {
     "id": "esta",
     "hr": "esta",
     "en": "this (feminine)",
     "pos": "pron.",
     "example": {
      "target": "Esta semana trabajo mucho.",
      "gloss": "This week I work a lot."
     }
    },
    {
     "id": "esto",
     "hr": "esto",
     "en": "this (neuter)",
     "pos": "pron.",
     "note": "for an idea or an unnamed thing rather than a specific noun; farther away is eso",
     "example": {
      "target": "Esto es para ti.",
      "gloss": "This is for you."
