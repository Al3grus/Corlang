      "title": "A1, as bases",
      "questions": [
        {
          "type": "MCQ",
          "difficulty": 1,
          "prompt": "'Obrigado' means:",
          "options": [
            "Thank you",
            "Please",
            "Hello",
            "Sorry"
          ],
          "answer": "Thank you",
          "explanation": "Obrigado = thank you (obrigada if you're a woman)."
        },
        {
          "type": "MCQ",
          "difficulty": 2,
          "prompt": "Feminine article for 'casa':",
          "options": [
            "a",
            "o",
            "um",
            "os"
          ],
          "answer": "a",
          "explanation": "casa is feminine → a casa."
        },
        {
          "type": "MCQ",
          "difficulty": 2,
          "prompt": "'Eu ___ dois irmãos.' (have)",
          "options": [
            "tenho",
            "tem",
            "sou",
            "estou"
          ],
          "answer": "tenho",
          "explanation": "ter: eu tenho."
        },
        {
          "type": "FILL",
          "difficulty": 2,
          "prompt": "Complete: 'Eu ___-me Paulo.' (verb chamar, to be called)",
          "answer": "chamo",
          "explanation": "chamar-se: eu chamo-me (ênclise: pronoun after the verb)."
        },
        {
          "type": "MCQ",
          "difficulty": 2,
          "prompt": "'___ é que ela se chama?' (asking someone's name)",
          "options": [
            "Como",
            "Onde",
            "Quando",
            "Quem"
          ],
          "answer": "Como",
          "explanation": "Como te chamas? / Como é que ela se chama? literally asks 'how is she called', the standard way to ask a name."
        },
        {
          "type": "MCQ",
          "difficulty": 3,
          "prompt": "Present of morar (eles):",
          "options": [
            "moram",
            "mora",
            "moramos",
            "moras"
          ],
          "answer": "moram",
          "explanation": "-AR verbs, eles = -am: moram."
        },
        {
          "type": "MCQ",
          "difficulty": 3,
          "prompt": "'Ela ___ médica.' (profession)",
          "options": [
            "é",
            "está",
            "tem",
            "são"
          ],
          "answer": "é",
          "explanation": "Profession/identity takes ser: ela é."
        },
        {
          "type": "MCQ",
          "difficulty": 3,
          "prompt": "'I am studying right now' in European Portuguese:",
          "options": [
            "Estou a estudar",
            "Estou estudando",
            "Vou estudar",
            "Estudei agora"
          ],
          "answer": "Estou a estudar",
          "explanation": "pt-PT uses estar a + infinitivo for actions in progress."
        },
        {
          "type": "REORDER",
          "difficulty": 3,
          "prompt": "Build the Portuguese for: 'I am from Portugal.'",
          "options": [
            "Eu",
            "sou",
            "de",
            "Portugal",
            "."
          ],
          "ordered": [
            "Eu",
            "sou",
            "de",
            "Portugal",
            "."
          ],
          "explanation": "Saying where you're from: ser + de + country."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Plural of 'a mulher':",
          "options": [
            "as mulheres",
            "as mulhers",
            "as mulher",
            "os mulheres"
          ],
          "answer": "as mulheres",
          "explanation": "Nouns ending in -r add -es in the plural: mulher → mulheres."
        }
      ]
    },
    {
      "id": "pt-a2",
      "levelId": "A2",
      "title": "A2, contar e descrever",
      "questions": [
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Completed past: 'Ontem ___ ao cinema.' (ir, eu)",
          "options": [
            "fui",
            "ia",
            "vou",
            "fosse"
          ],
          "answer": "fui",
          "explanation": "One finished event → pretérito perfeito simples: fui."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Past habit: 'Antigamente, nós ___ na praia.' (brincar)",
          "options": [
            "brincávamos",
            "brincámos",
            "brincamos",
            "brincaremos"
          ],
          "answer": "brincávamos",
          "explanation": "Habit in the past = imperfeito: brincávamos."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Reflexive placement, 'She washes herself' (European default):",
          "options": [
            "Ela lava-se.",
            "Ela se lava.",
            "Ela lava se.",
            "Se lava ela."
          ],
          "answer": "Ela lava-se.",
          "explanation": "In a plain affirmative sentence pt-PT uses ênclise: lava-se."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Demonstrative for something near the person you're talking to:",
          "options": [
            "esse",
            "este",
            "aquele",
            "isto"
          ],
          "answer": "esse",
          "explanation": "este = near me, esse = near you, aquele = far from both."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "'Estou constipado' means:",
          "options": [
            "I have a cold",
            "I am constipated",
            "I am tired",
            "I am worried"
          ],
          "answer": "I have a cold",
          "explanation": "False friend: constipado means 'has a cold' in pt-PT, not the English 'constipated'."
        },
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "'I don't see him': 'Não ___ vejo.'",
          "options": [
            "o",
            "lo",
            "no",
            "lhe"
          ],
          "answer": "o",
          "explanation": "não is a proclisis trigger: the pronoun moves before the verb, não o vejo."
        },
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "Clitic after an infinitive: 'Vou comprar o livro' → 'Vou comprá-___.'",
          "options": [
            "lo",
            "o",
            "no",
            "la"
          ],
          "answer": "lo",
          "explanation": "The infinitive drops -r and the pronoun becomes -lo: comprá-lo."
        },
        {
          "type": "FILL",
          "difficulty": 5,
          "prompt": "Complete: 'O Porto é mais barato ___ Lisboa.' (than)",
          "answer": "que",
          "accepted": [
            "do que"
          ],
          "explanation": "Comparative: mais + adjective + (do) que."
        },
        {
          "type": "REORDER",
          "difficulty": 5,
          "prompt": "Build the Portuguese for: 'Don't forget your ticket.'",
          "options": [
            "Não",
            "te",
            "esqueças",
            "do",
            "bilhete",
            "."
          ],
          "ordered": [
            "Não",
            "te",
            "esqueças",
            "do",
            "bilhete",
            "."
          ],
          "explanation": "Negative imperative: não triggers próclise (não te esqueças)."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "'Este é o ___ restaurante da cidade.' (the best)",
          "options": [
            "melhor",
            "mais bom",
            "o mais melhor",
            "boníssimo"
          ],
          "answer": "melhor",
          "explanation": "Bom has the irregular comparative/superlative melhor, never mais bom."
        }
      ]
    },
    {
      "id": "pt-b1",
