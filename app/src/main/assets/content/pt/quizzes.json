        },
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "'Amanhã eu ___ ao médico.' (ir, futuro simples)",
          "options": [
            "irei",
            "vou",
            "fui",
            "ia"
          ],
          "answer": "irei",
          "explanation": "The futuro simples adds endings straight onto the infinitive: irei."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "Subjunctive: 'Espero que tu ___ bem.' (estar)",
          "options": [
            "estejas",
            "estás",
            "estares",
            "estiveres"
          ],
          "answer": "estejas",
          "explanation": "esperar que + presente do conjuntivo: que tu estejas."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "Recent repeated action: '___ muito frio ultimamente.' (fazer)",
          "options": [
            "Tem feito",
            "Fez",
            "Fazia",
            "Fará"
          ],
          "answer": "Tem feito",
          "explanation": "Pretérito perfeito composto = repetition continuing up to now: tem feito."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "Earlier past: 'Quando cheguei, ele já ___.' (sair)",
          "options": [
            "tinha saído",
            "saiu",
            "tem saído",
            "saía"
          ],
          "answer": "tinha saído",
          "explanation": "Action before another past action → mais-que-perfeito composto: tinha saído."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "Relative: 'A cidade ___ nasci fica no norte.'",
          "options": [
            "onde",
            "que",
            "cujo",
            "quem"
          ],
          "answer": "onde",
          "explanation": "onde = where (place relative)."
        },
        {
          "type": "MCQ",
          "difficulty": 6,
          "prompt": "Reported speech: 'Ele disse que ___ cansado.' (estar)",
          "options": [
            "estava",
            "está",
            "esteja",
            "estará"
          ],
          "answer": "estava",
          "explanation": "Reporting verb in the past shifts present → imperfeito: estava."
        },
        {
          "type": "FILL",
          "difficulty": 6,
          "prompt": "Complete with the short participle: 'A carta foi ___ ontem.' (entregar)",
          "answer": "entregue",
          "explanation": "Double-participle verb: with ser/estar use the short form entregue."
        },
        {
          "type": "REORDER",
          "difficulty": 6,
          "prompt": "Build the Portuguese for: 'I think it's a good idea.'",
          "options": [
            "Acho",
            "que",
            "é",
            "uma",
            "boa",
            "ideia",
            "."
          ],
          "ordered": [
            "Acho",
            "que",
            "é",
            "uma",
            "boa",
            "ideia",
            "."
          ],
          "explanation": "Giving an opinion: achar que + indicative."
        },
        {
          "type": "MCQ",
          "difficulty": 7,
          "prompt": "'___ esteja a chover, vamos à praia.' (although)",
          "options": [
            "Embora",
            "Porque",
            "Já que",
            "Portanto"
          ],
          "answer": "Embora",
          "explanation": "Embora is a concession connector and always triggers the conjuntivo: embora esteja."
        }
      ]
    }
  ]
