      "title": "B1, opinião e hipótese",
      "questions": [
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "Polite request: 'Eu ___ um galão, por favor.' (querer)",
          "options": [
            "queria",
            "quero",
            "quis",
            "quererei"
