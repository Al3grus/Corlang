{
  "quizzes": [
    {
      "id": "pt-a0",
      "levelId": "A0",
      "title": "A0, as bases",
      "questions": [
        {
          "type": "MCQ",
          "difficulty": 1,
          "prompt": "What is the plural of 'limão'?",
          "options": [
            "limões",
            "limãos",
            "limans",
            "limées"
          ],
          "answer": "limões",
          "explanation": "Nouns ending in -ão usually take -ões: limão, limões."
        },
        {
          "type": "MCQ",
          "difficulty": 1,
          "prompt": "A woman thanking someone says:",
          "options": [
            "Obrigada",
            "Obrigado",
            "Obrigade",
            "Obrigados"
          ],
          "answer": "Obrigada",
          "explanation": "The word agrees with the speaker, not the person thanked."
        },
        {
          "type": "MCQ",
          "difficulty": 2,
          "prompt": "'Chamo-me Ana' means:",
          "options": [
            "My name is Ana",
            "I am calling Ana",
            "Ana is calling me",
            "Call me, Ana"
          ],
          "answer": "My name is Ana",
          "explanation": "Chamar-se is reflexive, and European Portuguese puts the pronoun after: chamo-me."
        },
        {
          "type": "MCQ",
          "difficulty": 2,
          "prompt": "Complete: 'Eu ____ de Faro.' (I am from Faro)",
          "options": [
            "sou",
            "estou",
            "tenho",
            "vou"
          ],
          "answer": "sou",
          "explanation": "Origin is identity, so it takes ser."
        },
        {
          "type": "MCQ",
          "difficulty": 3,
          "prompt": "Complete: 'Eles ____ em Lisboa esta semana.'",
          "options": [
            "estão",
            "são",
            "têm",
            "vão"
          ],
          "answer": "estão",
          "explanation": "Where someone is takes estar."
        },
        {
          "type": "MCQ",
          "difficulty": 3,
          "prompt": "Which number is 'quinze'?",
          "options": [
            "15",
            "5",
            "50",
            "14"
          ],
          "answer": "15",
          "explanation": "quinze = 15. Do not confuse it with cinco or cinquenta."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "Complete: 'Venho ____ Porto.' (I come from Porto)",
          "options": [
            "do",
            "da",
            "de",
            "no"
          ],
          "answer": "do",
          "explanation": "Porto carries the article o, and de plus o contracts to do."
        },
        {
          "type": "MCQ",
          "difficulty": 4,
          "prompt": "How do you say 'my mother'?",
          "options": [
            "a minha mãe",
            "o meu mãe",
            "a meu mãe",
            "o minha mãe"
          ],
          "answer": "a minha mãe",
          "explanation": "Mãe is feminine, so the article and the possessive both agree."
        },
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "Complete: 'Nós ____ português em casa.'",
          "options": [
            "falamos",
            "falam",
            "falas",
            "falo"
          ],
          "answer": "falamos",
          "explanation": "Regular -AR verbs take -amos for nós."
        },
        {
          "type": "MCQ",
          "difficulty": 5,
          "prompt": "Complete: '____ moras?' (Where do you live?)",
          "options": [
            "Onde",
            "Quando",
            "Quem",
            "Como"
          ],
          "answer": "Onde",
          "explanation": "Onde asks about place."
        }
      ]
    },
    {
      "id": "pt-a1",
