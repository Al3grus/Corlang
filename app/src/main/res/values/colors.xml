<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher backdrop: brand ink-navy, matching the loading screen so the blue Orbit Core
         rings (#2F7FAE) and molten core read with full contrast. -->
    <color name="ic_launcher_background">#0F1620</color>
    <!-- The splash/loader background; also the launch window color (first frame, no white flash). -->
    <color name="splash_background">#0F1620</color>
    <!-- The light theme's equivalent: warm paper, matching LightColors.background in Theme.kt.
         Keep the two in step, or a light-mode launch flashes one shade before settling. -->
    <color name="splash_background_light">#F6F0E6</color>
</resources>
